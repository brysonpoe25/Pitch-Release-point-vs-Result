# Copy to .env.local for local dev, and set the same two vars in the
# Vercel project's Environment Variables for the deployed site.
#
# Both are optional — without them the site falls back to the bundled
# static snapshot in src/data/pitches.json. Once you've created a Supabase
# project and run supabase/schema.sql + supabase/seed.sql against it, set
# these to switch the site over to live data.
#
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the deployed Release-Point Anomaly API (see ../api/), used by
# the /anomaly page. Required — must be the live Modal URL, e.g.
# https://<workspace>--release-point-anomaly-api-fastapi-app.modal.run
# Never point this at localhost in a deployed environment.
NEXT_PUBLIC_PIPELINE_API_URL=https://brysonpoe25--release-point-anomaly-api-fastapi-app.modal.run
